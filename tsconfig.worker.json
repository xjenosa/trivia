{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "types": ["./worker-configuration.d.ts", "@cloudflare/vitest-plugin/types"],
    "paths": { "@/*": ["./src/*"] }
  },
  "include": ["src/worker", "src/shared", "content", "test/room.test.ts", "test/helpers.ts"]
}
