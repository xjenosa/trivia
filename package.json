{
  "name": "trivia",
  "version": "1.0.0",
  "private": true,
  "description": "A live elimination trivia game for in-person events.",
  "license": "AGPL-3.0-only",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "deploy": "vite build && wrangler deploy",
    "types": "wrangler types",
    "typecheck": "wrangler types && tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.worker.json",
    "test": "vitest run",
    "test:e2e": "playwright test --project=chromium",
    "test:e2e:browsers": "playwright test --project=webkit --project=firefox",
    "shots": "node test/e2e/shots.mjs",
    "video": "node test/e2e/video.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@kawarp/core": "1.3.1",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "framework7-icons": "5.0.5",
    "qrcode-generator": "2.0.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwind-merge": "3.7.0",
    "three": "0.187.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.69.1",
    "@cloudflare/vitest-plugin": "1.8.1",
    "@playwright/test": "1.65.0",
    "@tailwindcss/vite": "4.3.5",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.187.0",
    "@vitejs/plugin-react": "6.3.0",
    "tailwindcss": "4.3.5",
    "typescript": "7.0.2",
    "vite": "8.3.8",
    "vitest": "4.1.12",
    "wrangler": "4.161.0"
  }
}
